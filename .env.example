# doubao2api 环境变量配置
# 复制此文件为 .env 并按需修改

# 服务端口
DOUBAO_PORT=9090

# 监听地址 (Docker 部署用 0.0.0.0)
DOUBAO_HOST=127.0.0.1

# API 密钥 (用于保护 /v1/* 端点，留空则不鉴权)
DOUBAO_API_KEY=

# 每分钟请求限制
DOUBAO_RPM_LIMIT=50

# Chromium 是否无头运行（浏览器单账号回退模式）
DOUBAO_HEADLESS=true

# Chromium 持久化用户目录（浏览器单账号回退模式）
# DOUBAO_BROWSER_DATA=~/.doubao_browser

# ── 多账号免费池 ──

# 多账号 session 目录（每个 *.json 为一个豆包 session 文件）
DOUBAO_ACCOUNTS_DIR=./accounts

# 直接以 Cookie 头创建单账号（仅在无任何 session 文件时生效）
# DOUBAO_COOKIE=sessionid=xxx; ttwid=xxx;

# 默认视频通道: free（免费池）或 volc（官方 API）
DOUBAO_VIDEO_CHANNEL=free

# ── 火山引擎官方通道 ──

# 官方 API Key（设置后启用 volc-chat / volc-image / volc-video 模型）
VOLC_API_KEY=

# 官方 API 地址
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 官方通道模型 ID
VOLC_CHAT_MODEL=doubao-pro-32k-250715
VOLC_IMAGE_MODEL=doubao-seedream-5-0-pro-260128
VOLC_VIDEO_MODEL=doubao-seedance-1-5-pro-251215

# ── 小云雀通道（剪映 Seedance 2.0）──

# 小云雀 Cookie 目录（每个 *.json 为一个剪映账号 Cookie）
XYQ_COOKIES_DIR=./xyq_cookies

# 生成视频的输出目录（通过 /xyq-files/{name} 下载）
XYQ_OUTPUT_DIR=./xyq_downloads

# 无头浏览器模式
XYQ_HEADLESS=true
